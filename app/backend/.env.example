# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=ache_seu_organico
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# For SQLite (development):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ache_seu_organico
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WebSocket / Redis
# Em producao, deixe USE_REDIS_CHANNEL_LAYER=True e informe a URL do Redis.
# Em desenvolvimento, o padrao e usar InMemoryChannelLayer quando DEBUG=True.
USE_REDIS_CHANNEL_LAYER=False
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_CAPACITY=1000
CHANNEL_LAYER_EXPIRY=60
CHANNEL_LAYER_GROUP_EXPIRY=86400

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
